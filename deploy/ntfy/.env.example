# Пример. Настоящий .env создаёт ./setup.sh — он не попадает в git.
# Значения с $ (хеши паролей) — обязательно в одинарных кавычках.
NTFY_BASE_URL='https://ntfy.example.ru'
NTFY_PORT=7090
TZ=Europe/Moscow
BISTRO_TOPIC='bistro_xxxxxxxxxxxx'
BISTRO_USER='paren'
BISTRO_USER_HASH='$2a$10$...'
BISTRO_PAGE_HASH='$2a$10$...'
BISTRO_TOKEN='tk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx'
# 1 — дискретный режим по умолчанию («Бистро / Ваш заказ принят»), пусто — подробные уведомления
BISTRO_DISCREET=
